{
  "manifest_version": 3,
  "name": "Gemini Tree — Branching Threads & Visual Tree",
  "version": "1.2.5",
  "description": "Adds nonlinear conversation branching, alternative prompt paths, and interactive tree visualization to Google Gemini.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://gemini.google.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Gemini Tree",
    "default_icon": "icons/icon-48.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
